//@version=6
// ─────────────────────────────────────────────────────────────────────────────
//  VWAP Multi-Jours (glissant)
//
//  Trace jusqu'à 4 VWAP « glissants » sur le graphique, chacun calculé sur une
//  fenêtre paramétrable en JOURS CALENDAIRES (7J, 30J, 90J, 365J, ...).
//
//  Le calcul est basé sur le temps (et non sur un nombre de bougies), donc le
//  résultat est cohérent quel que soit l'unité de temps du graphique
//  (1 min, 15 min, 1 h, 1 D...) et quel que soit le marché (crypto 24/7,
//  actions avec week-ends, etc.).
//
//  VWAP(N jours) = Σ(prix × volume) / Σ(volume) sur toutes les bougies dont
//  l'heure d'ouverture est comprise dans les N derniers jours.
// ─────────────────────────────────────────────────────────────────────────────
indicator("VWAP Multi-Jours (glissant)", shorttitle = "VWAP nJ", overlay = true, max_labels_count = 8)

// ═══════════════════════════════  Paramètres  ═══════════════════════════════
grpG           = "Général"
src            = input.source(hlc3, "Source du prix", group = grpG, tooltip = "Prix utilisé pour le calcul (hlc3 = (high+low+close)/3, standard pour un VWAP).")
hideIncomplete = input.bool(true, "Masquer tant que l'historique ne couvre pas la fenêtre", group = grpG, tooltip = "Si activé, la ligne n'apparaît que lorsque le graphique dispose d'au moins N jours d'historique. Sinon, le VWAP est affiché dès la première bougie (il équivaut alors à un VWAP cumulé depuis le début des données).")
showLabels     = input.bool(true, "Afficher les étiquettes (valeur à droite)", group = grpG)
labelOffset    = input.int(3, "Décalage des étiquettes (bougies)", minval = 0, maxval = 50, group = grpG)
lineWidth      = input.int(2, "Épaisseur des lignes", minval = 1, maxval = 5, group = grpG)

grp1 = "VWAP 1"
on1  = input.bool(true, "Activer", group = grp1, inline = "v1")
d1   = input.int(7, "Jours", minval = 1, maxval = 3650, group = grp1, inline = "v1")
c1   = input.color(color.new(color.aqua, 0), "", group = grp1, inline = "v1")

grp2 = "VWAP 2"
on2  = input.bool(true, "Activer", group = grp2, inline = "v2")
d2   = input.int(30, "Jours", minval = 1, maxval = 3650, group = grp2, inline = "v2")
c2   = input.color(color.new(color.orange, 0), "", group = grp2, inline = "v2")

grp3 = "VWAP 3"
on3  = input.bool(false, "Activer", group = grp3, inline = "v3")
d3   = input.int(90, "Jours", minval = 1, maxval = 3650, group = grp3, inline = "v3")
c3   = input.color(color.new(color.fuchsia, 0), "", group = grp3, inline = "v3")

grp4 = "VWAP 4"
on4  = input.bool(true, "Activer", group = grp4, inline = "v4")
d4   = input.int(365, "Jours", minval = 1, maxval = 3650, group = grp4, inline = "v4")
c4   = input.color(color.new(color.yellow, 0), "", group = grp4, inline = "v4")

// ═══════════════════  Sommes cumulées partagées (1 seule fois)  ═══════════════
// On stocke, pour chaque bougie, l'heure d'ouverture et les sommes cumulées
// Σ(prix×volume) et Σ(volume) depuis le début des données. Le VWAP sur une
// fenêtre quelconque est alors une simple différence de deux cumuls.
const int MS_PER_DAY = 86400000

var int[]   tArr     = array.new_int()
var float[] cumPVArr = array.new_float()
var float[] cumVArr  = array.new_float()

float vol = nz(volume)
var float cumPV = 0.0
var float cumV  = 0.0
cumPV += src * vol
cumV  += vol

array.push(tArr, time)
array.push(cumPVArr, cumPV)
array.push(cumVArr, cumV)

// ═══════════════════════  Calcul d'un VWAP glissant  ═════════════════════════
// Chaque appel conserve son propre pointeur `ptr` (index de la première bougie
// encore dans la fenêtre). Le pointeur ne fait qu'avancer : coût amorti O(1)
// par bougie, même avec 365 jours sur un graphique en 1 minute.
rollingVwap(int days) =>
    var int ptr = 0
    int cutoff = time - days * MS_PER_DAY
    // On sort de la fenêtre toutes les bougies ouvertes il y a plus de N jours.
    while ptr < array.size(tArr) and array.get(tArr, ptr) <= cutoff
        ptr += 1
    float basePV = ptr > 0 ? array.get(cumPVArr, ptr - 1) : 0.0
    float baseV  = ptr > 0 ? array.get(cumVArr,  ptr - 1) : 0.0
    float winPV  = cumPV - basePV
    float winV   = cumV  - baseV
    float v      = winV > 0 ? winPV / winV : na
    // La fenêtre est « complète » dès qu'au moins une bougie en est sortie,
    // c'est-à-dire dès que l'historique couvre plus de N jours.
    bool complete = ptr > 0
    [v, complete]

// Appels inconditionnels (obligatoire pour que l'état `var` reste cohérent).
[v1, ok1] = rollingVwap(d1)
[v2, ok2] = rollingVwap(d2)
[v3, ok3] = rollingVwap(d3)
[v4, ok4] = rollingVwap(d4)

// Valeur finale affichée (na = rien tracé).
shown(bool on, float v, bool complete) =>
    on and (complete or not hideIncomplete) ? v : na

p1 = shown(on1, v1, ok1)
p2 = shown(on2, v2, ok2)
p3 = shown(on3, v3, ok3)
p4 = shown(on4, v4, ok4)

// ════════════════════════════════  Tracés  ═══════════════════════════════════
plot(p1, "VWAP 1", color = c1, linewidth = lineWidth)
plot(p2, "VWAP 2", color = c2, linewidth = lineWidth)
plot(p3, "VWAP 3", color = c3, linewidth = lineWidth)
plot(p4, "VWAP 4", color = c4, linewidth = lineWidth)

// ══════════════════════════════  Étiquettes  ═════════════════════════════════
updateLabel(label lb, bool on, float v, int days, color c) =>
    label result = lb
    if barstate.islast
        if showLabels and on and not na(v)
            if na(result)
                result := label.new(bar_index, v, "", style = label.style_label_left, textcolor = color.white, size = size.small)
            label.set_xy(result, bar_index + labelOffset, v)
            label.set_text(result, "VWAP " + str.tostring(days) + "J  " + str.tostring(v, format.mintick))
            label.set_color(result, c)
        else if not na(result)
            label.delete(result)
            result := na
    result

var label lb1 = na
var label lb2 = na
var label lb3 = na
var label lb4 = na
lb1 := updateLabel(lb1, on1, p1, d1, c1)
lb2 := updateLabel(lb2, on2, p2, d2, c2)
lb3 := updateLabel(lb3, on3, p3, d3, c3)
lb4 := updateLabel(lb4, on4, p4, d4, c4)

// ══════════════════════  Avertissement : pas de volume  ══════════════════════
// Certains symboles (indices, forex chez certains courtiers) n'ont pas de
// volume : le VWAP est alors impossible à calculer.
var label warn = na
if barstate.islast
    if cumV == 0
        if na(warn)
            warn := label.new(bar_index, close, "", style = label.style_label_left, color = color.new(color.red, 20), textcolor = color.white, size = size.normal)
        label.set_xy(warn, bar_index + labelOffset, close)
        label.set_text(warn, "VWAP nJ : aucun volume disponible pour ce symbole")
    else if not na(warn)
        label.delete(warn)
        warn := na
